[Unit]
Description=Sala Reuniao WebSocket Signaling
After=network.target mariadb.service mysql.service
Wants=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/salareuniao/services/signaling
ExecStart=/usr/bin/php /var/www/salareuniao/services/signaling/server.php
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
