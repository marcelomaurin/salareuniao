<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="Sala Reunião · Servidor Broadcast"/>
      <UseAppBundle Value="False"/>
    </General>
    <BuildModes Count="1"><Item1 Name="Default" Default="True"/></BuildModes>
    <RequiredPackages Count="1"><Item1><PackageName Value="LCL"/></Item1></RequiredPackages>
    <Units Count="3">
      <Unit0><Filename Value="BroadcastDesktop.lpr"/><IsPartOfProject Value="True"/></Unit0>
      <Unit1><Filename Value="bcastmain.pas"/><IsPartOfProject Value="True"/><ComponentName Value="BroadcastForm"/><HasResources Value="True"/><ResourceBaseClass Value="Form"/></Unit1>
      <Unit2><Filename Value="bcastprocess.pas"/><IsPartOfProject Value="True"/></Unit2>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target><Filename Value="bin/BroadcastDesktop"/></Target>
    <SearchPaths><IncludeFiles Value="$(ProjOutDir)"/><UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/></SearchPaths>
    <CodeGeneration><Optimizations><OptimizationLevel Value="2"/></Optimizations></CodeGeneration>
  </CompilerOptions>
</CONFIG>
